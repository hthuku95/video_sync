VIBEVOICE_TTS_MODEL=microsoft/VibeVoice-Realtime-0.5B
VIBEVOICE_ASR_MODEL=microsoft/VibeVoice-ASR-7B
VIBEVOICE_OUTPUT_DIR=/tmp/videosync-vibevoice

# Adapter commands are deployment-specific until the chosen VibeVoice runtime
# is installed in the image. Commands receive these format variables:
# {model} {speaker} {output} {text}
VIBEVOICE_TTS_COMMAND=

# {model} {input} {hotwords} {language} {job_id}
VIBEVOICE_ASR_COMMAND=
