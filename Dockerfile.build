# Multi-stage, self-contained build — no host prebuilt binary required.
# Usable on GCP Cloud Build, any CI, or any VM. The legacy single-stage
# Dockerfile (COPY target/release/video_editor) is left untouched for the
# AWS build-host path (§10).
#
# Try with: docker build -f Dockerfile.build -t video-editor:gcp .
# PINNED (Nov 13 2026): rust:1-bookworm is a floating tag that re-pulled Rust
# 1.92 (shipped Thursday Nov 12 2026 — release day) whose type-inference
# change (rustc issue #148922) breaks sqlx-postgres 0.7.4's never-type usage
# (E0277 on `!` Decode). 1.92 is ALSO too new to keep; 1.82 is too old (new
# dep manifests need edition2024 / cargo >=1.85). 1.91 = the exact toolchain
# of the 9 green builds before the breakage. Bump deliberately, with a green
# build, never by accident via a base-image digest change.
FROM rust:1.91-bookworm AS chef
# cargo-chef pinned for determinism (0.1.71 was chosen during the Nov 13
# 2026 1.82 attempt; it builds fine on 1.91 as well).
RUN cargo install cargo-chef --locked --version 0.1.71
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
# Cargo.lock MUST be copied into the builder — chef cook only receives
# recipe.json otherwise and re-resolves dependencies (the floating-deps bug
# that broke Nov 13 2026 even after the lock was committed to the repo).
COPY --from=planner /app/recipe.json recipe.json
COPY --from=planner /app/Cargo.lock Cargo.lock
RUN cargo chef cook --release --recipe-path recipe.json
COPY . .
RUN cargo build --release

FROM debian:trixie-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    libpq5 \
    libssl3t64 \
    curl \
    python3 \
    python3-pip \
    && pip3 install --no-cache-dir --break-system-packages yt-dlp awscli \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/video_editor /usr/local/bin/video_editor
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /app/outputs /app/uploads /app/downloads
WORKDIR /app
EXPOSE 3000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["video_editor"]